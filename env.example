# Copy this file to ".env" and fill in your own values:   cp .env.example .env
# ".env" is listed in .gitignore and must NEVER be committed. This example file is safe to share.
# Do not wrap values in quotes.

# --- Safety switch -------------------------------------------------------------
# true  = only print/log what WOULD happen (nothing is moved, deleted, or changed)
# false = LIVE mode. Run in dry-run mode first and read the output.
DRY_RUN=true

# --- Jellyfin ------------------------------------------------------------------
# API key: Jellyfin Dashboard > API Keys > "+"
JELLYFIN_HOST_URL=http://YOUR_JELLYFIN_IP:8096
JELLYFIN_API_TOKEN=your_jellyfin_api_key

# --- Radarr (movies) -----------------------------------------------------------
# API key: Radarr > Settings > General > Security
RADARR_URL=http://YOUR_RADARR_IP:7878
RADARR_API_KEY=your_radarr_api_key

# --- Sonarr (TV) ---------------------------------------------------------------
# API key: Sonarr > Settings > General > Security
SONARR_URL=http://YOUR_SONARR_IP:8989
SONARR_API_KEY=your_sonarr_api_key

# --- Which libraries to manage ---------------------------------------------------
ENABLE_MOVIES=true
ENABLE_TV=false
# Deletes old seasons of favorited shows (TV only). Tag shows "keep-all-seasons" in Jellyfin first.
ENABLE_SEASON_PRUNING=false

# --- Notifications (optional: set any, all, or none) -----------------------------------
# Webhook URLs are secrets. Anyone with one can post to your channel, so keep them only in .env.
# Test your setup with:  docker compose run --rm auditor_service python collection_auditor.py --test-notify
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
NOTIFY_WEBHOOK_URL=
# Dry runs are silent unless you turn this on (messages are labelled [DRY RUN])
# NOTIFY_ON_DRY_RUN=false
# Include the list of titles still in Leaving Soon, with days left (default true)
# NOTIFY_LEAVING_SOON_DIGEST=true

# --- Where things live on YOUR server (the host side of the Docker volumes) -------
MEDIA_HOST_PATH=/path/to/your/media_storage
LOGS_HOST_PATH=/path/to/your/auditor_logs

# --- How often to run (hours). 0 = run once and exit ---------------------------------
RUN_INTERVAL_HOURS=24

# --- Safety switches (both default to false: the safe choice) -------------------------
# Let the script delete a title ITSELF when Radarr/Sonarr don't know it (or aren't configured).
# Off: such titles are skipped and reported, and you remove them by hand.
# ALLOW_FILESYSTEM_DELETE=false
# Accept holding/keep/removal folders on different mounts (moves become slow copy-then-delete).
# ALLOW_CROSS_FILESYSTEM_MOVES=false

# --- Optional tuning (defaults shown; uncomment to change) -------------------------
# MOVIE_WAIT_DAYS=30
# TV_WAIT_DAYS=60
# HOLDING_DAYS=7
# REMOVAL_DAYS=7
# MAX_ACTIONS_PER_RUN=10
# DISLIKE_TAG=not-at-all
# KEEP_ALL_SEASONS_TAG=keep-all-seasons
# PROTECT_TAG=keep-forever
# TV_NEW_EPISODES_RESET_CLOCK=true
# SEASON_PRUNE_GRACE_DAYS=30
# SEASON_PRUNE_AFTER_NEW_SEASON_DAYS=7

# --- Optional: folder names INSIDE the container (defaults shown) -------------------
# RADARR_TRANSIENT_PATH=/media/Movies
# RADARR_HOLDING_PATH=/media/Movies_hold
# RADARR_KEEP_PATH=/media/Movies_keep
# RADARR_REMOVAL_PATH=/media/Movies_removal
# SONARR_TRANSIENT_PATH=/media/TV
# SONARR_HOLDING_PATH=/media/TV_hold
# SONARR_KEEP_PATH=/media/TV_keep
# SONARR_REMOVAL_PATH=/media/TV_removal
