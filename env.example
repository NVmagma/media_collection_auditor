# Current JSON runtime environment example.
# Copy with: cp env.example .env && chmod 600 .env
# Keep .env outside an appdata directory being initialized, and never commit it.
# Use unquoted values with docker run --env-file .env.

# Preview and independent default-off optional actions.
DRY_RUN=true
MAX_ACTIONS_PER_RUN=10
ALLOW_PERMANENT_DELETE=false
ALLOW_TV_SEASON_DELETE=false
ENABLE_TV_SEASON_RETENTION=false
ORPHAN_CLEANUP_ENABLED=false
# Destructive options also require their saved warning acknowledgment in Settings.

# Web login and session signing. Replace the placeholders before deployment.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
WEB_SESSION_SECRET=replace-with-a-long-random-secret
# Set true when browsers reach the app through HTTPS.
WEB_SECURE_COOKIE=false

# Service URLs must be reachable from inside the auditor container.
JELLYFIN_HOST_URL=http://YOUR_JELLYFIN_IP:8096
JELLYFIN_API_TOKEN=your_jellyfin_api_key
RADARR_URL=http://YOUR_RADARR_IP:7878
RADARR_API_KEY=your_radarr_api_key
SONARR_URL=http://YOUR_SONARR_IP:8989
SONARR_API_KEY=your_sonarr_api_key

ENABLE_MOVIES=true
ENABLE_TV=false
DAILY_RUN_TIME=02:00
DAILY_RUN_TIMEZONE=UTC
TZ=UTC

# Optional read-only integration API. Token must be 32-256 URL-safe characters.
# INTEGRATION_API_TOKEN=replace-with-a-separate-random-token
# INTEGRATION_API_TITLE_DETAILS=true
# INTEGRATION_API_MEDIA=false
# INTEGRATION_API_COVERAGE=false

# Optional operational alerts. Configure and test saved destinations in Settings.
NOTIFY_OPERATIONAL_FAILURES=false
NOTIFY_ON_DRY_RUN=false
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
NOTIFY_WEBHOOK_URL=

# Lifecycle tuning. Saved web settings override environment values.
# MOVIE_WAIT_DAYS=30
# TV_WAIT_DAYS=60
# HOLDING_DAYS=7
# REMOVAL_DAYS=7
# DISLIKE_TAG=not-at-all
# KEEP_TAG=keep
# KEEP_ALL_SEASONS_TAG=keep-all-seasons
# PROTECT_TAG=keep-forever
# FAVORITES_TRIGGER_KEEP=true
# JELLYFIN_REFRESH_AFTER_AUDIT=false

# Default container paths. Mount the entire native media root at /media.
# MEDIA_PATH=/media
# RADARR_TRANSIENT_PATH=/media/Movies
# RADARR_HOLDING_PATH=/media/Movies_hold
# RADARR_KEEP_PATH=/media/Movies_keep
# RADARR_REMOVAL_PATH=/media/Movies_removal
# SONARR_TRANSIENT_PATH=/media/TV
# SONARR_HOLDING_PATH=/media/TV_hold
# SONARR_KEEP_PATH=/media/TV_keep
# SONARR_REMOVAL_PATH=/media/TV_removal
# TV_SEASON_HOLDING_PATH=/media/TV_seasons_leaving_soon

# Use docker/runtime.Dockerfile or the stable image for the current worker.
# The root Compose file and root Dockerfile are legacy development entry points.
