# Copy this file to ".env" and fill in your own values:   cp .env.example .env
# ".env" is listed in .gitignore and must NEVER be committed. This example file is safe to share.
# Do not wrap values in quotes.

# --- Safety switch -------------------------------------------------------------
# true  = only print/log what WOULD happen (nothing is moved, deleted, or changed)
# false = LIVE mode. Run in dry-run mode first and read the output.
DRY_RUN=true

# --- Jellyfin ------------------------------------------------------------------
# API key: Jellyfin Dashboard > API Keys > "+"
JELLYFIN_HOST_URL=http://10.0.90.10:8096
JELLYFIN_API_TOKEN=d73932d5468a46fc82d97c329705da00

# --- Radarr (movies) -----------------------------------------------------------
# API key: Radarr > Settings > General > Security
RADARR_URL=http://10.0.90.10:7878
RADARR_API_KEY=fe22743b11a3429e9ffc80ff292ef2fa

# --- Sonarr (TV) ---------------------------------------------------------------
# API key: Sonarr > Settings > General > Security
SONARR_URL=http://10.0.90.10:8989
SONARR_API_KEY=2f8e9baeeda6466392bd8fc080040d1b

# --- Which libraries to manage ---------------------------------------------------
ENABLE_MOVIES=true
ENABLE_TV=false
# Deletes old seasons of favorited shows (TV only). Tag shows "keep-all-seasons" in Jellyfin first.
ENABLE_SEASON_PRUNING=false

# --- Where things live on YOUR server (the host side of the Docker volumes) -------
MEDIA_HOST_PATH=/mnt/user/media_storage
LOGS_HOST_PATH=/mnt/scratch/Docker/media_archiver/app/auditor_logs

# --- How often to run (hours). 0 = run once and exit ---------------------------------
RUN_INTERVAL_HOURS=24

# --- Optional tuning (defaults shown; uncomment to change) -------------------------
# MOVIE_WAIT_DAYS=30
# TV_WAIT_DAYS=60
# HOLDING_DAYS=7
# REMOVAL_DAYS=7
# MAX_ACTIONS_PER_RUN=10
# DISLIKE_TAG=not-at-all
# KEEP_ALL_SEASONS_TAG=keep-all-seasons

# --- Optional: folder names INSIDE the container (defaults shown) -------------------
# RADARR_TRANSIENT_PATH=/media/Movies
# RADARR_HOLDING_PATH=/media/Movies_hold
# RADARR_KEEP_PATH=/media/Movies_keep
# RADARR_REMOVAL_PATH=/media/Movies_removal
# SONARR_TRANSIENT_PATH=/media/TV
# SONARR_HOLDING_PATH=/media/TV_hold
# SONARR_KEEP_PATH=/media/TV_keep
# SONARR_REMOVAL_PATH=/media/TV_removal
